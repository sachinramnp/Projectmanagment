:root{--ink:#20263a;--muted:#788096;--line:#e8eaf1;--bg:#f6f7fb;--purple:#635bdb}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.sidebar{position:fixed;inset:0 auto 0 0;width:238px;background:#20243a;color:#fff;padding:25px 17px;display:flex;flex-direction:column}.brand{font-size:21px;font-weight:800;color:#fff;text-decoration:none;display:block;margin:2px 10px 38px}.brand.dark{color:var(--ink);margin:0 0 28px}.sidebar nav{display:grid;gap:7px}.sidebar nav a{padding:12px 13px;color:#c9cce0;text-decoration:none;border-radius:9px}.sidebar nav a:hover{background:#343951;color:white}.sidebar nav small{color:#9298b5;padding:9px 13px}.sidebottom{margin-top:auto;padding:14px 10px;color:#d8daea}.main{margin-left:238px;padding:32px 38px;max-width:1600px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.topbar h2{font-size:27px;font-weight:750;margin:5px 0}.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:800;color:#888da5}.text-muted{color:var(--muted)!important}.btn-primary{background:var(--purple);border-color:var(--purple)}.btn-primary:hover{background:#5149c3;border-color:#5149c3}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:30px}.stat,.project-card,.list-card,.form-card{background:white;border:1px solid var(--line);border-radius:13px;box-shadow:0 3px 15px #252a4010}.stat{padding:18px 20px;display:grid;gap:7px}.stat span,.stat small{font-size:12px;color:var(--muted)}.stat strong{font-size:29px}.section-head{display:flex;align-items:center;justify-content:space-between;margin:22px 0 13px}.section-head h4{font-size:17px;font-weight:750;margin:0}.section-head a,.backlink{color:var(--purple);text-decoration:none;font-size:13px}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.project-card{padding:19px;text-decoration:none;color:inherit;transition:.15s}.project-card:hover{transform:translateY(-2px);box-shadow:0 7px 22px #252a4018}.project-icon{background:#efefff;color:var(--purple);border-radius:9px;padding:8px 11px}.project-card h5{font-size:16px;font-weight:750;margin:17px 0 7px}.project-card p{font-size:13px;color:var(--muted);min-height:38px}.badge{font-weight:600}.status-active{background:#e4f7ed;color:#19834a}.status-planning{background:#eaf0ff;color:#4167bc}.status-hold{background:#fff2d9;color:#99650b}.status-completed{background:#e4f7ed;color:#19834a}.status-archived{background:#ececf1;color:#666}.list-card{overflow:hidden}.task-row{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}.task-row:last-child{border:0}.task-row div{display:grid;gap:4px}.task-row b{font-size:13px}.task-row small{font-size:11px;color:var(--muted)}.empty{background:#fff;border:1px dashed #cdd0df;border-radius:13px;padding:35px;text-align:center;color:var(--muted);grid-column:1/-1}.form-card{padding:24px;max-width:800px}.form-card label,.auth-card label{font-size:12px;font-weight:700;margin-bottom:7px}.form-control,.form-select{border-color:#e2e4ed;padding:10px 12px;font-size:13px}.filterbar{display:flex;gap:10px;max-width:680px;margin-bottom:22px}.filterbar input{flex:1}.filterbar select{max-width:170px}.kanban{display:flex;align-items:flex-start;gap:14px;overflow-x:auto;padding-bottom:15px}.kanban-col{flex:0 0 265px;background:#eff0f6;border:1px solid #e6e7ef;border-radius:12px;padding:12px;min-height:300px}.col-title{display:flex;justify-content:space-between;padding:4px 4px 13px;font-size:13px}.col-title span{background:#e1e3ed;color:#666d83;border-radius:20px;padding:1px 8px}.cards{display:grid;gap:10px;min-height:45px}.task-card{background:white;border:1px solid #e5e7ef;border-radius:9px;padding:13px;box-shadow:0 2px 6px #20243a0a;cursor:grab}.task-card h6{font-size:13px;font-weight:750;margin:10px 0 5px}.task-card p{font-size:11px;color:var(--muted)}.task-foot{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;border-top:1px solid #f0f0f5;padding-top:9px;margin-top:10px}.priority{font-size:10px;font-weight:700}.priority-low{color:#6d7892}.priority-medium{color:#4167bc}.priority-high{color:#bd7b1c}.priority-urgent{color:#d64d5d}.add-inline{border:0;background:transparent;color:#747b93;font-size:12px;padding:12px 4px}.drop-hint{border:1px dashed #c9ccda;border-radius:8px;padding:16px;color:#a0a4b6;text-align:center;font-size:11px}.auth-shell{min-height:100vh;display:grid;place-items:center;padding:20px}.auth-card{background:#fff;border:1px solid var(--line);box-shadow:0 8px 35px #252a4012;border-radius:16px;width:min(100%,420px);padding:32px}.auth-card h2{font-size:23px;font-weight:750;margin-bottom:6px}.auth-card p{font-size:13px}.hero{max-width:760px;margin:8vh auto;text-align:center;padding:25px}.hero h1{font-size:58px;line-height:1.05;font-weight:850;margin:20px 0}.hero h1 em{font-style:normal;color:var(--purple)}.hero .lead{font-size:17px;color:var(--muted);max-width:540px;margin:0 auto 24px}.hero-card{max-width:440px;text-align:left;background:#fff;padding:22px;border:1px solid var(--line);border-radius:14px;margin:55px auto 0;box-shadow:0 12px 35px #20243a10}.hero-card .progress{height:8px;margin:18px 0 8px}.hero-card .progress-bar{background:var(--purple)}.member-chip{display:inline-block;background:#f0f0ff;color:#5149c3;border-radius:20px;padding:7px 12px;font-size:12px;margin:3px}.dragging{opacity:.45}@media(max-width:1000px){.sidebar{width:190px}.main{margin-left:190px;padding:25px}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.sidebar{position:static;width:auto;height:auto;padding:12px;display:block}.sidebar .brand{margin:0 8px 10px}.sidebar nav{display:flex;flex-wrap:wrap;gap:3px}.sidebar nav a{padding:8px;font-size:12px}.sidebar nav small,.sidebottom{display:none}.main{margin:0;padding:18px}.topbar{align-items:flex-start;flex-direction:column}.stats{gap:9px}.stat{padding:13px}.stat strong{font-size:23px}.project-grid{grid-template-columns:1fr}.filterbar{flex-wrap:wrap}.filterbar select{max-width:none;flex:1}.hero h1{font-size:42px}}